# Copy to .kamal/secrets (git ignored). Values come from Rails credentials or the shell.
KAMAL_REGISTRY_PASSWORD=$(rails credentials:fetch kamal.registry_password)
RAILS_MASTER_KEY=$(cat config/master.key)
DATABASE_URL_PRIMARY=$DATABASE_URL_PRIMARY
DATABASE_URL_EU_DE=$DATABASE_URL_EU_DE
DATABASE_URL_EU_NL=$DATABASE_URL_EU_NL
DATABASE_URL_QUEUE=$DATABASE_URL_QUEUE
DATABASE_URL_CACHE=$DATABASE_URL_CACHE
DATABASE_URL_CABLE=$DATABASE_URL_CABLE
MOSAIC_KEK_CURRENT=$(rails credentials:fetch mosaic.kek_current)
MOSAIC_BLIND_INDEX_KEY=$(rails credentials:fetch mosaic.blind_index_key)
TRIAGE_LLM_API_KEY=$(rails credentials:fetch triage.llm_api_key)
